# ---------------------------------------------------------------
# Keil MDK-ARM 编译输出（每个工程的 MDK-ARM/<工程名>/ 目录）
# ---------------------------------------------------------------
**/MDK-ARM/*/*.o
**/MDK-ARM/*/*.d
**/MDK-ARM/*/*.crf
**/MDK-ARM/*/*.dep
**/MDK-ARM/*/*.axf
**/MDK-ARM/*/*.hex
**/MDK-ARM/*/*.bin
**/MDK-ARM/*/*.elf
**/MDK-ARM/*/*.map
**/MDK-ARM/*/*.lst
**/MDK-ARM/*/*.lnp
**/MDK-ARM/*/*.sct
**/MDK-ARM/*/*.htm
**/MDK-ARM/*/*.html
**/MDK-ARM/*/*.build_log.htm

# Keil 用户界面状态（与具体电脑/窗口布局绑定）
**/MDK-ARM/*.uvguix.*
**/MDK-ARM/*.uvoptx.bak
**/MDK-ARM/*.bak

# Keil Assistant 插件日志与锁文件
**/MDK-ARM/.vscode/*.log
**/MDK-ARM/.vscode/*.lock

# 备份 / 临时文件
*.bak
*.old
*~
*.swp

# 操作系统杂项
Thumbs.db
Desktop.ini
.DS_Store
